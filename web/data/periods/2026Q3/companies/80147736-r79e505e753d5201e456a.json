09f4d8a18","pageStats":{"pageCount":11,"nonEmptyPages":11,"charCount":7802,"markdownBytes":null,"totalPages":11,"processedPages":11,"truncated":false,"pageNumbersVerified":true,"textStatus":"usable"},"strategyExcerpts":[{"text":"本季度货币政策延续适度宽松取向，央行综合运用并适时调整货币政策工具，加大逆周期调 节力度，提高隔夜逆回购操作频度、加大操作力度，增强短端利率调控的精准性和有效性。","sourceUrl":"https://pdf.dfcfw.com/pdf/H2_AN202610261830898286_1.pdf","page":6,"periodStart":"2026-07-01","periodEnd":"2026-09-30"},{"text":"本季度债券市场震荡走强，主要受基本面 承压、资金面平稳充裕及“资产荒”下配置盘与交易盘共振拉久期推动，长端利率下行、曲线平 坦化。","sourceUrl":"https://pdf.dfcfw.com/pdf/H2_AN202610261830898286_1.pdf","page":6,"periodStart":"2026-07-01","periodEnd":"2026-09-30"},{"text":"本基金在报告期内采用稳健的投资策略，灵活使用杠杆策略，积极调整久期策略，把握波段 操作机会，交易有相对性价比的政金债和国债，在保持流动性安全的基础上，努力为投资者获得 稳定的收益。","sourceUrl":"https://pdf.dfcfw.com/pdf/H2_AN202610261830898286_1.pdf","page":6,"periodStart":"2026-07-01","periodEnd":"2026-09-30"}],"strategyThemes":["行业/配置","估值/基本面","调仓/交易","风险/防守"],"strategySectionCoverage":{"schemaVersion":1,"method":"bounded-strategy-sections-v1","sourceUrl":"https://pdf.dfcfw.com/pdf/H2_AN202610261830898286_1.pdf","publishedAt":"2026-10-26","periodStart":"2026-07-01","periodEnd":"2026-09-30","kind":"quarterly","sourceTextHash":"31026ea4c4a776a3d06de6b98ca6836667dd899adba6449039de09164ef8287c","documentPeriodEvidence":[{"periodEnd":"2026-09-30","kind":"quarterly","page":1,"text":"2026年第3季度报告"}],"sections":[{"section":"4.4","heading":"4.4 报告期内基金的投资策略和运作分析","startPage":6,"endPage":6,"pages":[6],"endSection":"4.5","endHeading":"4.5 报告期内基金的业绩表现","sectionBounded":true,"pageNumbersVerified":true,"pageLimitReached":false,"textLimitReached":false,"contentChars":640,"sentenceCount":11,"contentHash":"fec4aa8a0b0a8637345018656d475a6574c06c38eb0d3576d1b4bc31089e3a0e"}],"sectionCount":1,"contentChars":640,"sentenceCount":11,"complete":true,"status":"complete","reasonCodes":[]},"strategyAnalysis":{"schemaVersion":1,"scope":"selected-evidence","method":"explicit-language-rules-v1","status":"available","analysisCoverage":"selected-evidence","semanticAnalysisComplete":false,"sourceSectionComplete":true,"sentenceCount":11,"categorySentenceCounts":{"market-review":8,"portfolio-operations":1,"outlook":2,"unclassified":2},"categoryCountsOverlap":true,"selectedSentenceCount":7,"omittedSentenceCount":4,"maxQuotes":8,"maxQuoteChars":160,"evidence":[{"id":"s0-0","text":"2026年三季度，面对国际地缘政治冲突延宕、全球能源市场反复波动的外部环境，以及国内极端天气多发和新旧动能转换带来的阶段性压力，我国经济克服困难、保持平稳运行，延续向新向优的发展态势。","page":6,"pages":[6],"section":"4.4","sentenceIndex":0,"categories":["market-review"],"sourceUrl":"https://pdf.dfcfw.com/pdf/H2_AN202610261830898286_1.pdf","periodStart":"2026-07-01","periodEnd":"2026-09-30","quoteTruncated":false,"isInference":false,"securityMentions":[],"languageSignals":{"operation":false,"causalConnective":false,"outlook":false}},{"id":"s0-1","text":"投资方面，固定资产投资继续回落，但投向结构改善更为突出。","page":6,"pages":[6],"section":"4.4","sentenceIndex":1,"categories":["unclassified"],"sourceUrl":"https://pdf.dfcfw.com/pdf/H2_AN202610261830898286_1.pdf","periodStart":"2026-07-01","periodEnd":"2026-09-30","quoteTruncated":false,"isInference":false,"securityMentions":[],"languageSignals":{"operation":false,"causalConnective":false,"outlook":false}},{"id":"s0-2","text":"现代化基础设施体系加快建设，高技术产业投资增速连续加快，知识产权产品投资和设备购置投资保持较快增长，创新驱动成效持续显现。","page":6,"pages":[6],"section":"4.4","sentenceIndex":2,"categories":["market-review"],"sourceUrl":"https://pdf.dfcfw.com/pdf/H2_AN202610261830898286_1.pdf","periodStart":"2026-07-01","periodEnd":"2026-09-30","quoteTruncated":false,"isInference":false,"securityMentions":[],"languageSignals":{"operation":false,"causalConnective":false,"outlook":false}},{"id":"s0-4","text":"文旅休闲、数字信息等体验式消费活力释放，绿色智能商品和新零售业态表现亮眼。","page":6,"pages":[6],"section":"4.4","sentenceIndex":4,"categories":["unclassified"],"sourceUrl":"https://pdf.dfcfw.com/pdf/H2_AN202610261830898286_1.pdf","periodStart":"2026-07-01","periodEnd":"2026-09-30","quoteTruncated":false,"isInference":false,"securityMentions":[],"languageSignals":{"operation":fa